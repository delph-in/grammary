;			       ] ] ].
					   
; TAG 18/01/15: Arabic p+np rule has a more specific CASE 
;Specific for p+np					   
p-head-np-comp2-phrase :+ 
  [ NON-HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD.CASE gen ].
	
