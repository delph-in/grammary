;--------------------------------------------------------------------------
;                         ARABIC EXTRACTION RULES 
;--------------------------------------------------------------------------
; TAG 11/10/15: Added HEAD-DTR.SYNSEM lex-synsem as subject extraction is Arabic is lexical (like complement extraction).
; TAG 12/2/15: The topicalized subject must be +DEF.
extracted-subj-phrase :+ basic-extracted-arg-phrase & [ SYNSEM.NON-LOCAL.SLASH.LIST.FIRST.CAT.HEAD.DEF +,
                           HEAD-DTR.SYNSEM lex-synsem  ].

; TAG 28/1/15: commented out, the general phrase in types-phrasal does not include the OBJ-MARK specification
;; TAG 11/01/15: moved because arabic does not have OBH-MARK
;extracted-v-head-comp4-np-phrase := extracted-comp4-phrase & 
;  [ HEAD-DTR.SyNSEM.LOCAL.CAT [ HEAD v_pron_head,
;				VAL [ DEP4.DEP.LOCAL.CAT [ HEAD noun,
;						       VAL.R-FRAME no-arg ] ] ] ].
								   
					
