;np-complement-lex-item := basic-one-arg-not-qpart-lex-item &
;NURIT-TEMPORARILY COMMENTED OUT
;np-complement-lex-item := basic-one-arg-not-qpart-lex-item & no-hcons-lex-item.
;   [ SYNSEM [ LOCAL.CAT.VAL [ DEP2 < [ LOCAL.CONT.HOOK.INDEX ref-ind & #ind ] >,
;			      DEP3 < >,
;			      DEP4 < > ],
;	      LKEYS.KEYREL [ ARG1 #ind ] ] ]. 

;LHS: QUE changing the infrastructure to make most lexical types QUE-PART -
