;;;;;;;;;;;;;;;;;;;
;;Idiomatic verbs;;
;;;;;;;;;;;;;;;;;;;
;LHS 11/02/15 MWEs (V_NP)
;NM 19/2/15: type name changes; E.g., ni instead of n_i, ni_pi instead of n_i_p_i

lhdq_i:= arg12_ni_infinitive_le &
  [ STEM < "lhdq" >, 
    SYNSEM [ LKEYS.KEYREL.PRED _i-tighten-reduce_v_rel ] ]. 
	
hidq_i := arg12_ni_past_le &	     
  [ STEM < "hidq" >,
    SYNSEM [ LOCAL.CAT [ HEAD.CNCRD png-3sm,
			 VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-belt-expenses_n_rel ],
	     LKEYS.KEYREL.PRED _i-tighten-reduce_v_rel ] ].
hidqh_i := arg12_ni_past_le &	     
  [ STEM < "hidqh" >,
    SYNSEM [ LOCAL.CAT [ HEAD.CNCRD png-3sf,
                          VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-belt-expenses_n_rel ],
	     LKEYS.KEYREL.PRED _i-tighten-reduce_v_rel ] ].	     
mhdq_i := arg12_ni_present_le &	     
  [ STEM < "mhdq" >,
    SYNSEM [ LOCAL.CAT [ HEAD.CNCRD png-3sm,
                          VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-belt-expenses_n_rel ],
	     LKEYS.KEYREL.PRED _i-tighten-reduce_v_rel ] ].
ihdq_i := arg12_ni_future_le &	     
  [ STEM < "ihdq" >,
    SYNSEM [ LOCAL.CAT [ HEAD.CNCRD png-3sm,
                          VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-belt-expenses_n_rel ],
	     LKEYS.KEYREL.PRED _i-tighten-reduce_v_rel ] ].

;LHS 11/02/15 MWEs (V+PP), selects for an idiomatic specific "m" (which, in turn, will select "hyc")
ird_i := arg15_pi_past_le &	     
  [ STEM < "ird" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sm,
                           VAL.PPSORT.DEP5-P _m_from_tree_ip_rel ] ],
	     LKEYS.KEYREL.PRED _i-descend-backoff_v_rel ] ].

;LHS 15/02/15: V+NPpossessive+PP
vmn_i := arg125_ni_pi_xarg12_past_le &
  [ STEM < "vmn" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sm,
			               VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-head-reality_n_rel,
    			           VAL.PPSORT.DEP5-P _b_in_sand_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-hide-ignore_v_rel ] ].

vmnh_i := arg125_ni_pi_xarg12_past_le &
  [ STEM < "vmnh" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sf,
			               VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-head-reality_n_rel,
    			           VAL.PPSORT.DEP5-P _b_in_sand_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-hide-ignore_v_rel ] ].	     

;POSS Nurit 12/2/15 - selects for an idiomatic specific "m", which, in turn selects for possessed "kliw" and
;requires agreement between the subject and the possessor
;NM 19/2/15: type name changes; E.g., ni instead of n_i, ni_pi instead of n_i_p_i
;also - linking between arguments is defined in types-verb-lex (e.g., xarg15 for linking between dep1 and dep5)	          
ica_i := arg15_pi_xarg15_past_le &	     
  [ STEM < "ica" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sm,
                           VAL.PPSORT.DEP5-P _m_from_tools_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-leave-lose_v_rel ] ].

icah_i := arg15_pi_xarg15_past_le &	     
  [ STEM < "icah" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sf,
                           VAL.PPSORT.DEP5-P _m_from_tools_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-leave-lose_v_rel ] ].

;LHS 15/02/15: V+NP+PP/PPpossessive
hwcia_i := arg125_n_pi_xarg25_past_le & 
  [ STEM < "hwcia" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sm,
    			           VAL.PPSORT.DEP5-P _m_from_tools_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-cause_leave-lose_v_rel ] ].

hwciah_i := arg125_n_pi_xarg25_past_le & 
  [ STEM < "hwciah" >,
    SYNSEM [ LOCAL [ CAT [ HEAD.CNCRD png-3sf,
    			           VAL.PPSORT.DEP5-P _m_from_tools_ip_rel ] ],
	         LKEYS.KEYREL.PRED _i-cause_leave-lose_v_rel ] ].

