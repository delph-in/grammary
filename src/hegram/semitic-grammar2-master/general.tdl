;;; Lexical Types
;;;;;;;;;;;;;;;;;;;

; General type definitions are found here. POS-specific definitions in respective files.
;NURIT-QUE add QUE constraint
;LHS 2005 can't be a head feature, so moved it up
basic-not-qpart-lex-item := lex-item & 
  [ SYNSEM.NON-LOCAL.QUE <! !> ].

; NURIT-QUE:  Just so we know - when this was the definition non-local-concat-phrase didn't work
; [ SYNSEM.NON-LOCAL.QUE 0-dlist ].

;=============================================
; Noun types are defined in noun-lex-types
;=============================================
; Verb types are defined in verb-lex-types
;=============================================
;==============================================
; Adjective types are defined in verb-lex-types
;==============================================
;=============================================
; Adverb types are defined in adverb-lex-types
;=============================================
;================================================
; Preposition types are defined in prep-lex-types
;================================================

;;; Others

; We treat question particles as complementizers.
; Here is the lexical type for complementizers.

;LHS: this supertype's MC value is underspecified (luk), which will result in an underspecified MC value for the CP it is part of.
;If the CP shouldn't be an independent clause, use the subypte nmc-complementizer-lex-item.
;LHS: only takes finite complements (to prevent 'dni xeb e mh' for a verbal 'mh')
;LHS: Barring complementizer stranding in topicalization & wh-complement questions (canonical-synsem for the complement)
;LHS 10/12: no tense constraint because head-subj will take care of that
complementizer-lex-item := raise-sem-lex-item &
  [ SYNSEM.LOCAL.CAT [ HEAD comp &
                            [ MOD < > ],
                       VAL [ R-FRAME arg2,
                             DEP1.REAL arg1-,
                             DEP2 [ REAL arg2-,
                                    DEP canonical-synsem & [ LOCAL [ CAT [ MC +,
                                                                     HEAD v_pron_head,
                                                                     VAL [ R-FRAME #link,
                                                                           DEP1.REAL #link,
                                                                           DEP2.REAL #link,
                                                                           DEP3.REAL #link,
                                                                           DEP4.REAL #link,
                                                                           DEP4.REAL #link,
                                                                           DEP6.REAL #link ] ] ] ] ],
                             DEP3.REAL arg3-,
                             DEP4.REAL arg4-,
                             DEP5.REAL arg5-,
                             DEP6.REAL arg6- ] ] ].

; Subtype for question particles. Constrains SF to ques. LHS: changes to "yes-no" in order to free qpart-lex-item for actual que particles.
qpart-yes-no-lex-item := complementizer-lex-item &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.SF ques ].


;LHS: Subtype for complementizers that create non-independent CPs.
nmc-complementizer-lex-item := complementizer-lex-item &
  [ SYNSEM.LOCAL.CAT.MC - ].

;NURIT-QUE - commented out QUE
;LHS: QUE supertype for non yes-no questions - the leaves are in specific pos type files.
;LHS 1505 REVIVED new version
qpart-lex-item := no-hcons-lex-item &
  [ SYNSEM [ LOCAL #loc & [ CAT [VAL [ 	DEP3.REAL arg3-,
			      		DEP4.REAL arg4-,
			      		DEP5.REAL arg5-,
			      		DEP6.REAL arg6- ] ] ],
	     NON-LOCAL [ SLASH 0-dlist ,
	     		 QUE <! #loc !> ] ] ].
	     		 
	     		 
; NURIT-QUE: Just so we know - when this was the definition non-local-concat-phrase didn't work
;	     		 QUE 1-dlist & [ LIST < #loc > ] ] ] ].

;RELS <! #rel & relation !>


;LHS 1505 REVIVED new version
np-vp-cp-qpart-lex-item := qpart-lex-item & single-rel-lex-item & norm-hook-lex-item.

;LHS & NM: the mrs for this can't directly mirror the mrs of its counterpart (no-icons-lex-item path clashes), but this results in a correct
;mrs. + added the event-relation so that ARG0 will be an event
cp-qpart-lex-item := np-vp-cp-qpart-lex-item &
  [ SYNSEM [ LOCAL [ CONT.HOOK.INDEX event & [ E.TENSE finite ], 
		     CAT [ HEAD comp,
		         VAL [ R-FRAME arg2,
			       DEP1.REAL arg1-,
		         DEP2.REAL arg2+ ] ] ],
	     LKEYS.KEYREL event-relation ] ].
	     

