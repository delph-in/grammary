;;; Nominals

; types which are shared by nouns and adjectives

  
                                   
;===============================================
; ==== 2 DIMENSIONS: Agreement & Case =====
;===============================================


;DIMENSION 1: Agreement (12+ types)

3sm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3sm ] ].

3pm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3pm ] ].

3sf-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3sf ] ].

3pf-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3pf ] ].

1s-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-1s ] ].

3df-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3df ] ].
				   
3pdm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3pdm ] ].
				   
3dm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3dm ] ].


; TAG 11/2/15: added nominal lexemes underspecified for person, for adjectives to be underspecified for person (for predicative use).
; Also added a singular type which is underspecified for gender, for adjectives like "iph". 

s-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-s ] ].
                   
sm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-sm ] ].

pm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-pm ] ].

sf-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-sf ] ].

pf-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-pf ] ].

df-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-df ] ].
				   
pdm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-pdm ] ].
				   
dm-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-dm ] ].

; LHS 19/5/15: added a plural type which is underspecified for gender, for adjectives originating from dinflections that fit the bill. 
p-nominal-lex := lex-item & 
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-p ] ].

; LHS 21/5/15: added types which are underspecified only for gender, which are needed for nouns which can be for either gender.
3s-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3s ] ].
3p-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3p ] ].
1p-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-1p ] ].
; LHS 21/5/15: added types which are needed for more diverse pronouns.
2sf-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-2sf ] ].
2sm-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-2sm ] ].
2pm-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-2pm ] ].
2pf-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-2pf ] ].

; LHS 21/5/15: added types which are underspecified only for number, which are needed for nouns which can be for either number.
3f-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3f ] ].
3m-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3m ] ].
                   
; LHS 3/9/15: added types which are underspecified for number, and gender which are needed for nouns which can be for either number and gender.                   
3-nominal-lex := lex-item &
  [ SYNSEM.LOCAL [ CAT.HEAD.CNCRD #png,
                   CONT.HOOK.INDEX.PNG #png & png-3 ] ].

				   
;DIMENSION 2: Case


non-nominative-lex := lex-item & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE non-nom ] ] ].
non-accusative-lex := lex-item & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE non-acc ] ] ].
nominative-lex := non-accusative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE nom ] ] ].
accusative-lex := non-nominative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE acc ] ] ].
genetive-lex := non-accusative-lex & non-nominative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE gen ] ] ].

; TAG 26/1/15: added definiteness as a third dimension shared by nouns and adjectives 
; DIMENSION 3: Definiteness 
def-lex := lex-item & [ SYNSEM.LOCAL.CAT [ HEAD [ DEF + ] ] ] .
indef-lex := lex-item & [ SYNSEM.LOCAL.CAT [ HEAD [ DEF - ] ] ] .


