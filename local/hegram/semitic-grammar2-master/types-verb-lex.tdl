;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Verbs - general types;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;
general-verb-lex := norm-sem-lex-item &
  [ SYNSEM [ LOCAL [ CAT [ 	MC - ],
		     CONT.HOOK [ INDEX #index,
				 ICONS-KEY.CLAUSE #index,
				 CLAUSE-KEY #index ] ],
	     LKEYS.KEYREL event-relation ] ].

;LHS 0210: took out the constraint on DEP2's OBJ-MARK (in the new valence system it is no longer necessary)
;Nurit 26/10 added constraint for basic-verb-lex and for basic-copula-lex: R-FRAME = S-FRAME. This is not true for raising verbs.
basic-verb-lex := general-verb-lex & 
  [ SYNSEM [ LOCAL [ CAT [ 	HEAD verb,
  				VAL [ 	R-FRAME #frame,
  					S-FRAME #frame ] ] ] ] ].

raising-verb-lex := general-verb-lex & 
  [ SYNSEM [ LOCAL [ CAT [ 	HEAD verb ] ] ] ].


;nurit 9/6 - define types of copulas and prons
;LHS 0210: took out the constraint on DEP2's OBJ-MARK (in the new valence system it is no longer necessary)
basic-copula-lex := general-verb-lex & 
  [ SYNSEM [ LOCAL [ CAT [ 	HEAD v_pron_head,
  				VAL [ 	R-FRAME #frame,
  					S-FRAME #frame ] ] ],
	     LKEYS.KEYREL.PRED "_cop_rel" ] ].

basic-pron-cop-lex := basic-copula-lex &
[ SYNSEM.LOCAL.CAT.HEAD pron ].

basic-verb-cop-lex := basic-copula-lex &
[ SYNSEM.LOCAL.CAT.HEAD verb ].

;LHS & NM: the actual constraint (other than the head) is taken from intransitive-lex-item, which we're mirroring.
;added the event-relation so that ARG0 will be an event
;LHS 11/11: added SUBJ-ARG arg1 so that "dni mh l/ylidi dnh" won't get a parse where the PP is comp1 (this means that "mh" will
;stand for an active and non-accusative verb)
;vp-qpart-lex-item := np-vp-cp-qpart-lex-item & icons-lex-item & non-mod-lex-item &
;  [ SYNSEM [ LOCAL [ CAT [ VAL [ DEP2.REAL arg2-,
;                                 R-FRAME arg1 & #frame,
;                                 S-FRAME #frame,
;                                 SUBJ-ARG arg1 ],
;                           HEAD verb ] ],
; 	           LKEYS.KEYREL event-relation &  [ ARG1 ref-ind  ] ] ].
;LHS 070915: expanding subj1-subj2 fix: adding characteristics defined in arg1_np to vp-qpart-lex-item. Since we can't know what the subject is of 
;a vp inf/bn mh, we're assuming it's arg1 by default. Before this change, VP mh in sentences like "dni nish mh" weren't linked to the main verb.
vp-qpart-lex-item := np-vp-cp-qpart-lex-item & icons-lex-item & non-mod-lex-item &
  [ SYNSEM [ LOCAL [ CAT [ VAL [ DEP1 #subj & [ DEP.LOCAL [ CAT [ HEAD noun ],
                                                            CONT.HOOK [ TOPREL.PRED l-rel,
                                                                        INDEX #xarg ] ] ],
                                 DEP2.REAL arg2-,
                                 R-FRAME arg1 & #frame,
                                 S-FRAME #frame,
                                 SUBJ-ARG arg1,
                                 SUBJ-DEP #subj ],
                           HEAD verb ],
                     CONT.HOOK [ TOPREL.ARG1 #xarg,
                                 XARG #xarg ]  ],
 	           LKEYS.KEYREL event-relation &  [ ARG1 ref-ind  ] ] ]. 	           

vp-inf-qpart-lex-item := vp-qpart-lex-item &
  [ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE infinitive ].

;LHS 11/11: added for beinoni mh.
vp-bn-qpart-lex-item := vp-qpart-lex-item &
  [ SYNSEM.LOCAL [ CONT.HOOK.INDEX.E.TENSE present ] ].
 

;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Complex pre-LE types;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Simple pre-LE types appear in types-deps-lxm (i.e., ones that only specify R-FRAME in addition to inheriting from relevant super-types)

;;;Complex pre-LE types appear here (i.e., ones that add additional information):
;===========
;==Raising==
;===========
;For subject-raising DEP2 "verbs" (e.g., yewi - prev implementation)
;NM 3/9/15: subj1-subj2 fix: coindexation is just with XARG, which is coindexed with
;arg1 or arg2 in the lower VP, depending on the verb type, not with ARG1
;arg12_v_subj-raising := arg12_v &
;  [ SYNSEM.LOCAL.CAT.VAL [	S-FRAME arg2,
;  				SUBJ-ARG #arg1,
;				DEP1 #subj,
;				DEP2.DEP [ LOCAL [  CAT.VAL [ SUBJ-ARG #arg1 & arg1,
;							                  DEP1 #subj],
;						            CONT.HOOK [ XARG #ind,
;		                    TOPREL.ARG1 #ind ] ] ] ] ].

arg12_v_subj-raising := arg12_v_raising &
  [ SYNSEM.LOCAL [ CAT.VAL [ S-FRAME arg2,
 				            DEP1 #subj,
            				DEP2.DEP.LOCAL.CAT.VAL.SUBJ-DEP #subj & 
                                            [ DEP.LOCAL.CONT.HOOK.XARG #ind ] ],
                    CONT.HOOK.XARG #ind ] ].


;For subject raising DEP4 verbs (e.g. nrah)
arg14_j_subj-raising := arg14_j &
  [ SYNSEM.LOCAL.CAT.VAL [	S-FRAME arg4 ] ].
arg14_njr_subj-raising := arg14_njr &
  [ SYNSEM.LOCAL.CAT.VAL [	S-FRAME arg4 ] ].                                      							 
  
;For DEP2 object to subject raising DEP4 verbs (e.g. rah, mca):
arg124_n_v_obj-raising := arg124_n_v &
  [ SYNSEM.LOCAL.CAT [ VAL [ S-FRAME arg14 ] ] ].  
arg124_n_a_obj-raising := arg124_n_a &
  [ SYNSEM.LOCAL.CAT.VAL [ S-FRAME arg14,
                           SUBJ-ARG #arg1,
                           DEP4.DEP [ LOCAL [  CAT.VAL [ SUBJ-ARG #arg1 & arg1 ] ] ] ] ].

;For DEP3 subject-to-object raising DEP4 verbs (e.g., yeh)
;yeh at dnh gdwlh, yeh at dnh tlmidh
arg134_n_nj_obj_raising := arg134_n_nj & 
  [ SYNSEM.LOCAL.CAT.VAL [ S-FRAME arg14,
                           SUBJ-ARG #arg1,
                           DEP4.DEP [ LOCAL [  CAT.VAL [ SUBJ-ARG #arg1 & arg1 ] ] ] ] ].                             

;===========
;==Control==
;===========
;Nurit 9/6 : linking patterns of control verbs are defined lexically
;For DEP2 subject-control verbs (e.g., nish)
;NM 3/9/15: subj1-subj2 fix: coindexation is just with XARG, which is coindexed with
;arg1 or arg2 in the lower VP, depending on the verb type, not with ARG1
;arg12_v_subj-cntrl := arg12_v &
;  [ SYNSEM.LOCAL.CAT.VAL [	DEP1.DEP [ LOCAL.CONT.HOOK.INDEX #ind ],
;				DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind,
;                                     TOPREL.ARG1 #ind ] ] ] ].
arg12_v_subj-cntrl := arg12_v &
  [ SYNSEM.LOCAL.CAT.VAL [	DEP1.DEP [ LOCAL.CONT.HOOK.INDEX #ind ],
				DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind ] ] ] ].


;;For subject-control verbs with PP DEP3 objects (e.g., hbvix)
;arg123_v_p_subj-cntrl := arg123_v_p &
;  [ SYNSEM.LOCAL.CAT.VAL [	DEP1.DEP [ LOCAL.CONT.HOOK.INDEX #ind ],
;				DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind,
;                                     TOPREL.ARG1 #ind ] ] ] ].
;;For object-control verbs with PP DEP3 objects (e.g., hreh)
;arg123_v_p_obj-cntrl := arg123_v_p &
;  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind,
;                                                         TOPREL.ARG1 #ind ] ],
;                            DEP3.DEP [ LOCAL.CONT.HOOK.TOPREL.ARG2 #ind ] ] ].
;;For object-control verbs with NP DEP3 objects (e.g., ekny)
;arg123_v_n_obj-cntrl := arg123_v_n &
;  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind,
;                                                         TOPREL.ARG1 #ind ] ],
;                            DEP3.DEP [ LOCAL.CONT.HOOK.INDEX #ind ] ] ].
;;For object-control verbs with PP DEP5 objects (e.g., biqe)
;arg125_v_p_obj-cntrl := arg125_v_p &
;  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind,
;                                                         TOPREL.ARG1 #ind ] ],
;                            DEP5.DEP [ LOCAL.CONT.HOOK.TOPREL.ARG2 #ind ] ] ].

;;LHS 100915: expanding subj1-subj2 fix: now, other types of control verbs have coindexation just with XARG, which is coindexed with
;;arg1 or arg2 in the lower VP, depending on the verb type, not with ARG1.
;;For subject-control verbs with PP DEP3 objects (e.g., hbvix)
arg123_v_p_subj-cntrl := arg123_v_p &
  [ SYNSEM.LOCAL.CAT.VAL [	DEP1.DEP [ LOCAL.CONT.HOOK.INDEX #ind ],
				DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind ] ] ] ].
;For object-control verbs with PP DEP3 objects (e.g., hreh)
arg123_v_p_obj-cntrl := arg123_v_p &
  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind ] ],
                            DEP3.DEP [ LOCAL.CONT.HOOK.TOPREL.ARG2 #ind ] ] ].                            						                                                              
;For object-control verbs with NP DEP3 objects (e.g., ekny)
arg123_v_n_obj-cntrl := arg123_v_n &
  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind ] ],
                            DEP3.DEP [ LOCAL.CONT.HOOK.INDEX #ind ] ] ].
;For object-control verbs with PP DEP5 objects (e.g., biqe)
arg125_v_p_obj-cntrl := arg125_v_p &
  [ SYNSEM.LOCAL.CAT.VAL [	DEP2.DEP [ LOCAL.CONT.HOOK [ XARG #ind ] ],
                            DEP5.DEP [ LOCAL.CONT.HOOK.TOPREL.ARG2 #ind ] ] ].

;========================================
;==IDIOMS with special linking patterns==
;========================================
;NM 19/2/15: linking is defined here, not in the lexicon

;Idiomatic (linking DEP1 with XARG of DEP5 NP in "ica m kliw")
arg15_pi_xarg15 := arg15_pi &
  [ SYNSEM.LOCAL [ CONT.HOOK.XARG #xarg,
                   CAT.VAL [ DEP5.DEP.LOCAL.CONT.HOOK.XARG #xarg ] ] ].                                                         				

;Idiomatic (linking DEP2 with XARG of DEP5 NP in "hwcia at X m kliw")
arg125_n_pi_xarg25 := arg125_n_pi &
  [ SYNSEM.LOCAL [ CAT.VAL [ DEP2.DEP.LOCAL.CONT.HOOK.INDEX #xarg,
                             DEP5.DEP.LOCAL.CONT.HOOK.XARG #xarg ] ] ].                                                         				

;Idiomatic (linking DEP1 with XARG of DEP2 NP in "vmn at raew b xwl")
arg125_ni_pi_xarg12 := arg125_ni_pi &
  [ SYNSEM.LOCAL [ CONT.HOOK.XARG #xarg,
                   CAT.VAL [ DEP2.DEP.LOCAL.CONT.HOOK.XARG #xarg ] ] ].     
                   
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Tense specified pre-LE types;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TAG 26/5/15 : Tense-classified types. LE types inherit from these types. In heb-types-verb and ara-types-verb additional
; constraints are added to these types with ":+"

infinitive-verb-lex := general-verb-lex &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE infinitive ].

past-verb-lex := general-verb-lex &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE past ].

present-verb-lex := general-verb-lex &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE present ]. 

future-verb-lex := general-verb-lex & 
[ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE finite ].

imperative-verb-lex := general-verb-lex &
[ SYNSEM.LOCAL.CONT.HOOK.INDEX.E.TENSE imperative,
  SYNSEM.LOCAL.CONT.HOOK.INDEX.SF comm ].  
                                                   				

