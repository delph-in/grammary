;NM 25/1/15 - I moved case classifications to types-nominal-lex so that they will be shared by nouns and adjectives
;DIMENSION 1: Agreement (12+ types)

;;; Special types for case-marked lexemes:

;non-nominative-lex := noun-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE non-nom ] ] ].
;non-accusative-lex := noun-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE non-acc ] ] ].
;nominative-lex := non-accusative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE nom ] ] ].
;accusative-lex := non-nominative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE acc ] ] ].
;genetive-lex := non-nominative-lex & non-accusative-lex & [ SYNSEM.LOCAL.CAT [ HEAD [ CASE gen ] ] ].

