;;;  Lexicon for proper nouns that are shared between Swedish and English
;;;


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;Proper nouns


;;names of persons

sara := proper-noun-lex-fem &
   [ STEM < "Sara" >,
     SYNSEM [ LKEYS.KEYREL.CARG "Sara" ] ].

ann := proper-noun-lex-fem &
   [ STEM < "Ann" >,
     SYNSEM [ LKEYS.KEYREL.CARG "Ann" ] ].

tom := proper-noun-lex-masc &
   [ STEM < "Tom" >,
     SYNSEM [ LKEYS.KEYREL.CARG "Tom" ] ].

bob := proper-noun-lex-masc &
   [ STEM < "Bob" >,
     SYNSEM [ LKEYS.KEYREL.CARG "Bob" ] ].


;;geographical names

london := proper-noun-lex-thing &
   [ STEM < "London" >,
     SYNSEM [ LKEYS.KEYREL.CARG "London" ] ].

stockholm := proper-noun-lex-thing &
   [ STEM < "Stockholm" >,
     SYNSEM [ LKEYS.KEYREL.CARG "Stockholm" ] ].
