;==========================================
; ==== CROSS-CLASSIFICATIONS (LEAVES) =====
;==========================================
;NM 25/1/15: changed 3sm-noun-lex to 3sm-nominal-lex (3sm and all the rest of the pngs)
; Basically, the types are subtypes of noun types from types-noun-lex + case information

;;; For indefinite singular and plural (non-dual) accusative common nouns:
indef-cmn-acc-3sm-lex := indef-cmn-3sm-noun-lex  & accusative-lex.
indef-cmn-acc-3pm-lex := indef-cmn-3pm-noun-lex  & accusative-lex.
indef-cmn-acc-3sf-lex := indef-cmn-3sf-noun-lex  & accusative-lex.
indef-cmn-acc-3pf-lex := indef-cmn-3pf-noun-lex  & accusative-lex.

;;; For indefinite singular and plural (non-dual) non-accusative common nouns:
indef-cmn-nonacc-3sm-lex := indef-cmn-3sm-noun-lex  & non-accusative-lex.
indef-cmn-nonacc-3pm-lex := indef-cmn-3pm-noun-lex  & non-accusative-lex.
indef-cmn-nonacc-3sf-lex := indef-cmn-3sf-noun-lex  & non-accusative-lex.
indef-cmn-nonacc-3pf-lex := indef-cmn-3pf-noun-lex  & non-accusative-lex.

;;; For sound (regular) plural male nouns: (only the case information is arabic-specific)
def-cmn-nonnom-3pm-lex := def-cmn-3pm-noun-lex & non-nominative-lex. 
def-cmn-nom-3pm-lex := def-cmn-3pm-noun-lex & nominative-lex.
indef-cmn-nonnom-3pm-lex := indef-cmn-3pm-noun-lex & non-nominative-lex. 
indef-cmn-nom-3pm-lex := indef-cmn-3pm-noun-lex & nominative-lex.

;;; TAG 190115: added def-cmn-nonnom-3non-sm-lex and indef-cmn-nonnom-3non-sm-lex, 
;; for 3m duals and plurals which look the same in non-nom CASE
; NM 25/1/15: changed non-s to pd
def-cmn-nonnom-3pdm-lex := def-cmn-noun-lex & 3pdm-nominal-lex & non-nominative-lex.
indef-cmn-nonnom-3pdm-lex := indef-cmn-noun-lex & 3pdm-nominal-lex & non-nominative-lex.

;;; TAG 190115: Adding acc and non-acc for proper nouns
;;; For accusative proper nouns:
3sm-proper-noun-acc-lex := 3sm-proper-noun-lex & accusative-lex.
3sf-proper-noun-acc-lex := 3sf-proper-noun-lex & accusative-lex. 

;;; For non-accusative proper nouns:
3sm-proper-noun-nonacc-lex := 3sm-proper-noun-lex & non-accusative-lex. 
3sf-proper-noun-nonacc-lex := 3sf-proper-noun-lex & non-accusative-lex. 

;;; For dual nouns:
def-cmn-3dm-noun-lex := def-cmn-noun-lex & 3dm-nominal-lex.
indef-cmn-3dm-noun-lex := indef-cmn-noun-lex & 3dm-nominal-lex.
def-cmn-3df-noun-lex := def-cmn-noun-lex & 3df-nominal-lex.
indef-cmn-3df-noun-lex := indef-cmn-noun-lex & 3df-nominal-lex.

def-cmn-nonnom-3dm-lex := def-cmn-3dm-noun-lex & non-nominative-lex. 
def-cmn-nonnom-3df-lex := def-cmn-3df-noun-lex & non-nominative-lex.
def-cmn-nom-3dm-lex := def-cmn-3dm-noun-lex & nominative-lex.
def-cmn-nom-3df-lex := def-cmn-3df-noun-lex & nominative-lex.
indef-cmn-nonnom-3dm-lex := indef-cmn-3dm-noun-lex & non-nominative-lex. 
indef-cmn-nonnom-3df-lex := indef-cmn-3df-noun-lex & non-nominative-lex.
indef-cmn-nom-3dm-lex := indef-cmn-3dm-noun-lex & nominative-lex.
indef-cmn-nom-3df-lex := indef-cmn-3df-noun-lex & nominative-lex.


