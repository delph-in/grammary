;;; -*- Mode: TDL; Coding: utf-8 -*-
;;; Nouns
;LHS:Added definite lexical entries, and the DEF feature to all nouns. Relevant changes to the semantics should be made accordingly.

;=============================================================================
;================================= NOUNS =====================================
;=============================================================================

   
;;;;;;;;;;;;;;;;;;;
;;Idiomatic nouns;;
;;;;;;;;;;;;;;;;;;;
;LHS 10/02/15 MWEs (hidq at hxgwrh; ird m hyc)
hxgwrh_i := def-cmn-3sf-noun-lex & 
  [ STEM < "hxgwrh" >,
    SYNSEM.LKEYS.KEYREL.PRED _i-belt-expenses_n_rel ].

hyc_i := def-cmn-3sm-noun-lex & 
  [ STEM < "hyc" >,
    SYNSEM.LKEYS.KEYREL.PRED _i-tree-idea_n_rel ].

;POSS Nurit 12/2/15 - ica m hklim/kliw
hklim_i := def-cmn-3pm-noun-lex &
  [ STEM < "hklim" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-tools-temper_n_rel ].
kliw_i := poss-cmn-3pm-3sm-noun-lex &
  [ STEM < "kliw" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-tools-temper_n_rel ].
klih_i := poss-cmn-3pm-3sf-noun-lex &
  [ STEM < "klih" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-tools-temper_n_rel ].   
    

;LHS 15/02/15: V+NPpossessive+PP
hrae_i := def-cmn-3sm-noun-lex &
  [ STEM < "hrae" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-head-reality_n_rel ].
raeh_i := poss-cmn-3sm-3sf-noun-lex &
  [ STEM < "raeh" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-head-reality_n_rel ].
raew_i := poss-cmn-3sm-3sm-noun-lex &
  [ STEM < "raew" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-head-reality_n_rel ].
xwl_i := indef-cmn-3sm-noun-lex &
  [ STEM < "xwl" >,
   SYNSEM.LKEYS.KEYREL.PRED _i-sand-reality_n_rel ].

