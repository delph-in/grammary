;;; Option #1: Different hierarchy for Hebrew and Arabic: 
;;; Hierarchy for arabic:
;;; TAG: commented out because there is a common case hierarchy in general.tdl
;NM 25/1/15 - I moved these definitions to general so that the definitions will be in one place

+nj :+ [ CASE case ].

; case := *top*.
; non-nom := case.
; non-acc := case.
; acc := non-nom.
; nom := non-acc.
; gen := non-nom & non-acc. 

;;; Number
;du := non-sg.










