;$Lexical types from the pre-revolution era, that are no longer in use, from hebrew.tdl$

pp-transitive-lex-item := basic-two-arg-no-hcons &
  [ ARG-ST < [ LOCAL.CONT.HOOK.INDEX ref-ind & #ind1 ],
	      [ LOCAL.CONT.HOOK.INDEX event & #ind2 ] >,
     SYNSEM.LKEYS.KEYREL [ ARG1 #ind1,
			   ARG2 #ind2 ] ].
			   
;COPULA: all the copulas share the same relation, but are divided in terms of linking
cop-transitive-lex-item := basic-two-arg-no-hcons &
 [ SYNSEM.LKEYS.KEYREL.PRED "_cop_rel" ].
 
;ARG2 is an individual (ref-ind for NP; event for CP and VP)
cop-ind-transitive-lex-item := cop-transitive-lex-item &
  [ ARG-ST < [ LOCAL.CONT.HOOK.INDEX ref-ind & #ind1 ],
	      [ LOCAL.CONT.HOOK.INDEX individual & #ind2 ] >,
     SYNSEM.LKEYS.KEYREL [ ARG1 #ind1,
			   ARG2 #ind2 ] ].

