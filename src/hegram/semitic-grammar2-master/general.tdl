;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Matrix Type Addenda
;;;;;;;;;;;;;;;;;;;;;;;;;
;POSS LHS 10/02/15: adding the CLT feature, that marks whether something inclues a clitic (currently only used for possessive clitics)
noun :+ [ CASE case,
	  CLT clt-min ].

clt-min := avm.
clt := clt-min.
no-clt := clt-min.
;For "klbi".
poss-clt := clt.
;For "alinw".
comp-clt := clt.
;For "ahbtih".
obj-clt := clt.

; This grammar includes head-modifier rules.  To keep
; out extraneous parses, constrain the value of MOD on
; various subtypes of head.  This may need to be loosened later.
; This constraint says that only adverbs, adjectives,
; and adpositions can be modifiers.

+nvcdmo :+ [ MOD < > ].

;$Definiteness$
+nj :+ [DEF bool].

png :+ [ PER person,
    NUM number,
    GEND gender ].

;========================
;COPULA - add a Pron head type
;$Agreement$ the type hierarchy below png is defined in types-png.tdl
;The CNCRD feature needs to be introduced once, so I created an intermediate head subtype for that
png_head := head & [CNCRD png].
+nvjdm :+ png_head.

;LHS: COPULA - because we need a disjunctive type for verbs and pron:
v_pron_head := head.
;LHS: COPULA - because we need a disjunctive type for verbs, complementizers and pron:
v_c_pron_head := head.
pron := png_head & v_pron_head & v_c_pron_head.

;;;;;;;;;;;;;;
;;; Features
;;;;;;;;;;;;;;

;;; Case 
;; TAG 11/01/15: Case moved to hebrew.tdl because Arabic has different type-hierarchy
; case := *top*.
; acc := case.
; non-acc := case.
; nom := non-acc.
; other := non-acc.

; TAG 14/1/15: new case types for hebrew & arabic
 case := *top*.
 non-nom := case.
 non-acc := case.
 acc := non-nom.
 nom := non-acc.
 gen := non-nom & non-acc. 

;;; Person

person := *top*.
3rd := person.
non-3rd := person.
2nd := non-3rd.
1st := non-3rd.

;;; Number
;; TAG 190115: adding a non-sg type for Arabic dual+plural which look the same in the non-nom CASE
number := *top*.
sg := number.
non-sg := number.
pl := non-sg.
du := non-sg.


;;; Gender

gender := *top*.
fem := gender.
masc := gender.

;;; Tense

;TAG 15/3/15: changing the Tense hierarchy to fit Arabic (adding a future-present super type and a non-finite super type)
;LHS: clustering all finite tenses together to enable barring of subject in infinitival clauses
finite := tense.
non-finite := tense.
present+future := finite.
present := present+future.
infinitive := non-finite.
past+future := finite.
past := past+future.
future := past+future & present+future.
imperative := finite.

;; TAG 26/5/15: add type for pro-drop

;;; Mood
; TAG 26/5/15: Adding a mood hierarchy for Arabic

indicative := mood.
subjunctive := mood.
jussive := mood.
sbj-f := mood.
juss-f := mood.


