;   [ ARG-ST < [ LOCAL.CONT.HOOK.LTOP #ltop1 ] >,
;     SYNSEM [ LOCAL [ CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.LTOP #ltop2 ] >,
; 		     CONT [ HCONS <! qeq &
; 				   [ HARG #harg,
; 				     LARG #larg ] !>,
; 			    RELS <! relation,
; 				  message & 
; 				  [ LBL #msg,
; 				    PRED proposition_m_rel,
; 				    MARG #harg ] !>,
; 			    HOOK [ LTOP #msg ] ] ],
; 	     LKEYS.KEYREL subord-relation &
; 		   [ LBL #larg,
; 		     L-HNDL #ltop1,
; 		     R-HNDL #ltop2 ] ] ].

;LHS 1606: if this is ever relevant, we should make its ancestor lex-item, and make sure the linking is done properly,
;before uncommenting it
;basic-subord-conjunction-lex := basic-one-arg-not-qpart-lex-item &
;  [ ARG-ST < [ LOCAL.CONT.HOOK.LTOP #ltop1 ] >,
;    SYNSEM [ LOCAL [ CAT.HEAD.MOD < [ LOCAL.CONT.HOOK.LTOP #ltop2 ] >,
;		     CONT [ HCONS <! !>,
;			    RELS <! relation !>,
;			    HOOK [ LTOP #ltop ] ] ],
