; TAG 28/9/16: Predicative adjectives and nouns in the Arabic zero-copula construction must be nom.
adjp-zero-copula-phrase :+ [  ARGS.FIRST.SYNSEM.LOCAL [ CAT [ HEAD.CASE nom ]]].  

np-zero-copula-phrase :+ [  ARGS.FIRST.SYNSEM.LOCAL [ CAT [ HEAD.CASE nom ]]].


v-head-np-comp4-phrase :+ [ NON-HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD.CASE acc ] ] ]. 

head-adjp-comp4-phrase :+ [ NON-HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD.CASE acc ] ] ]. 
  
;~~~~~~~~~~~~~~~~~~~ DEP6 RULES ~~~~~~~~~~~~~~~~~~~~~~~~~~~
; TAG 11/3/15: added a rule that combines arg6_np with the verb, and sets its case to ACC and an np-pp disjunctive version of head-comp6-phrase for Arabic
	
head-np-comp6-phrase := head-comp6-phrase &
 [ NON-HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD noun & [ CASE acc ] ] ] ] .
	