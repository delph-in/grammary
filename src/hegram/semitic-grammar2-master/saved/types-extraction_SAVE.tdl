;============================================
;NON-LOCAL DEPENDENCIES
;============================================
;LHS for object extraction (acts on lexical items)
basic-extracted-arg-phrase-lex-head-dtr := head-only &
  [ SYNSEM [ LIGHT -,
             LOCAL.CAT.VAL.PPSORT #ppsort ],
    HEAD-DTR.SYNSEM lex-synsem & [ LOCAL.CAT.VAL.PPSORT #ppsort ] ].

;LHS for subject extraction and zero copula object extraction (acts on phrases)	
basic-extracted-arg-phrase-phr-head-dtr := head-only &
  [ SYNSEM [ LIGHT -,
             LOCAL.CAT.VAL.PPSORT #ppsort],
    HEAD-DTR.SYNSEM phr-synsem & [ LOCAL.CAT.VAL.PPSORT #ppsort ] ].	

;LHS 1505 a common ancestor for complement extraction rules (except zero pron) + restricting comp extraction to only happen on 
;verbs (otherwise, it would also happen on mh)
extracted-comp-phrase := basic-extracted-arg-phrase-lex-head-dtr & no-rels-ccont-rule & no-icons-ccont-rule &
  [ HEAD-DTR top-deps-lxm & [ SYNSEM.LOCAL.CAT.HEAD v_pron_head ] ].

;--------------------------------------------------------------------------
;                           EXTRACTION RULES - SLASH
;--------------------------------------------------------------------------

;------------------------------------------
;           SUBJ
;------------------------------------------
;		[ NON-LOCAL [ SLASH [ LIST [ FIRST #gap, 
;					     REST [ FIRST #gap, 
;					     	    REST #last ]], 
;				      LAST #last ] ],



extracted-subj-que-phrase := basic-extracted-arg-phrase-phr-head-dtr & head-compositional & que-rel-percolate-phrase & no-hcons-ccont-rule & no-rels-ccont-rule & no-icons-ccont-rule &
  [ SYNSEM canonical-synsem &
		[ NON-LOCAL [ SLASH 1-dlist & [ LIST < #gap > ] ],
		  LOCAL [ CAT.VAL [  C-FRAME #frame,
						   SPR < >,
						   DEP1 [ REAL #frame & arg1+ ],
						   DEP2 #dep2,
						   DEP3 #dep3,
						   DEP4 #dep4 ],
			  CONT.HOOK.INDEX.SF ques ] ],
    HEAD-DTR [ 	   SYNSEM phr-synsem & [ NON-LOCAL.SLASH 0-dlist,
					 LOCAL [ CONT.HOOK [ 	TOPREL.ARG1 #ind1,
					 			INDEX.E.TENSE finite ],
					 	 CAT [ HEAD v_pron_head,
						       VAL [ C-FRAME #frame,
								   DEP1 [ REAL arg1-,
									  LOCAL #gap & [ CONT.HOOK.INDEX  ref-ind & #ind1] ],
								   DEP2 #dep2 & [ REAL #frame ],
								   DEP3 #dep3 & [ REAL #frame ],
								   DEP4 #dep4 & [ REAL #frame ] ],
							MC na ] ] ] ] ].




;------------------------------------------
;           COMP
;------------------------------------------

extracted-comp-slash-phrase := extracted-comp-phrase & que-rel-percolate-phrase.

;Nurit-0805 The slash is defined in the mother and is taken from the LOCAL of DEP2. The previous version had slash-gap do the job,
;but it created a mess because of SLASH amalgamation


extracted-comp2-slash-phrase := extracted-comp-slash-phrase &
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ 	C-FRAME #frame,
							DEP1 #dep1,
                         	SPR #spr,
                         	DEP2 [ REAL #frame & arg2+ ],
                         	DEP3 #dep3,
                         	DEP4 #dep4 ],
                   	MC #mc ],
	    NON-LOCAL [ SLASH 1-dlist & [ LIST < #gap > ] ] ],
    HEAD-DTR [ SYNSEM [	LOCAL [ CAT [ VAL [ C-FRAME #frame,
			       	            DEP1 #dep1,
                               	     	    SPR #spr,
                                            DEP2 [ REAL arg2-,
					           LOCAL #gap ],
                                     	    DEP3 #dep3,
                                     	    DEP4 #dep4 ],
                               	      MC #mc ] ] ] ] ].		


; When an NP in DEP2 is extracted the LOCAL values of DEP2 need to be set and linking has to occur 
;(instead of what happens in head-np-comp2-phrase and v-head-np-comp2-phrase

;LHS 1505 the head daughter must be specified as verb, to bar extraction out of PPs.
extracted-comp2-np-slash-phrase := extracted-comp2-slash-phrase & no-hcons-ccont-rule &
  [ HEAD-DTR [ SYNSEM [ LOCAL [ CONT.HOOK.TOPREL.ARG2 #ind2, 
				CAT [ VAL.DEP2.LOCAL [ 	CAT [ HEAD noun & 
                                                          	[ CASE acc ],
                                                              OBJ-MARK +-or-- ,
                                                       	      VAL.SPR < > ],
                                                 	CONT.HOOK.INDEX  ref-ind & #ind2 ] ] ] ] ] ].                                                 

extracted-comp2-vp-slash-phrase := extracted-comp2-slash-phrase & hcons-ccont-rule &
  [ C-CONT.HCONS <! [ HARG #harg,
                      LARG #larg ] !>,
    HEAD-DTR.SYNSEM [ LOCAL [ 	CONT.HOOK.TOPREL [ ARG2 #harg ],
                                CAT.VAL.DEP2 [ 	LOCAL [ CAT.HEAD verb,
                                                   	    CONT.HOOK [	LTOP  #larg,
                                 	                             	INDEX event & [ E.TENSE infinitive ] ] ] ] ] ] ]. 

extracted-comp2-cp-slash-phrase := extracted-comp2-slash-phrase & hcons-ccont-rule &                                                
  [ C-CONT.HCONS <! [ HARG #harg,
                      LARG #larg ] !> ,
    HEAD-DTR.SYNSEM [ LOCAL [ 	CONT.HOOK.TOPREL [ ARG2 #harg ],
		      		CAT [ VAL.DEP2.LOCAL [ CAT.HEAD comp,
                                                 CONT.HOOK [ LTOP  #larg,
                                                             INDEX event & [ E.TENSE finite ] ] ] ] ] ] ].
 
;Nurit-0805 The slash is defined in the mother and is taken from the LOCAL of DEP2. The previous version had slash-gap do the job,
;but it created a mess because of SLASH amalgamation
extracted-comp3-slash-phrase := extracted-comp-slash-phrase & no-hcons-ccont-rule &
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ 	C-FRAME #frame,
			       	DEP1 #dep1,
                         	SPR #spr,
                         	DEP3 [ REAL #frame & arg3+ ],
                         	DEP4 #dep4,
                         	DEP2 #dep2 ],
                   	MC #mc ],
	    NON-LOCAL.SLASH 1-dlist & [ LIST < #gap > ] ],
    HEAD-DTR [ SYNSEM [	LOCAL [ CAT [ VAL [ C-FRAME #frame,
			       	            DEP1 #dep1,
                               	     	    SPR #spr,
                                            DEP3 [ REAL arg3-,
					           LOCAL #gap ],
                                     	    DEP4 #dep4,
                                     	    DEP2 #dep2 ],
                               	      MC #mc ] ] ] ] ].				                                                 

extracted-comp3-np-slash-phrase := extracted-comp3-slash-phrase &
  [ HEAD-DTR [ SYNSEM [ LOCAL [ CONT.HOOK.TOPREL.ARG3 #ind3,
				CAT.VAL.DEP3.LOCAL [ CAT [ HEAD noun & 
							            [ CASE acc ],
                                           		   OBJ-MARK +-or-- ,
                                           		   VAL.SPR < > ],
                                                     CONT.HOOK.INDEX  ref-ind & #ind3 ] ] ] ] ].    
;PPSORT                                                 
extracted-comp3-pp-slash-phrase := extracted-comp3-slash-phrase & 
  [ SYNSEM.LOCAL.CONT.HOOK.TOPREL.ARG3 #ind3,
    HEAD-DTR [ SYNSEM [ LOCAL [ CONT.HOOK.TOPREL.ARG3 #ind3,
          CAT.VAL.DEP3 [  LOCAL [ CAT.HEAD adp,
                                  CONT.HOOK.TOPREL [ PRED _l_p_rel,
                                	      	     ARG2 ref-ind & #ind3 ] ] ] ] ] ] ].    

;Nurit-0805 The slash is defined in the mother and is taken from the LOCAL of DEP2. The previous version had slash-gap do the job,
;but it created a mess because of SLASH amalgamation
extracted-comp4-slash-phrase := extracted-comp-slash-phrase & no-hcons-ccont-rule &
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ 	C-FRAME #frame,
			       	DEP1 #dep1,
                         	SPR #spr,
                         	DEP4 [ REAL #frame & arg4+ ],
                         	DEP3 #dep3,
                         	DEP2 #dep2 ],
                   	MC #mc ],
	    NON-LOCAL.SLASH 1-dlist & [ LIST < #gap > ] ],
    HEAD-DTR [ SYNSEM [	LOCAL [ CAT [ VAL [ C-FRAME #frame,
			       	            DEP1 #dep1,
                               	     	    SPR #spr,
                                            DEP4 [ REAL arg4-,
					           LOCAL #gap & [ CONT.HOOK.LTOP handle & #hand4 ] ],
                                     	    DEP3 #dep3,
                                     	    DEP2 #dep2 ],
                               	      MC #mc ],
                          CONT.HOOK.TOPREL [ ARG4 #hand4 ] ] ] ] ].
;PPSORT				                                                 
extracted-comp4-pp-slash-phrase := extracted-comp4-slash-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL.CAT.VAL [ PPSORT #ppsort,
                            	    DEP4.LOCAL [ CONT.HOOK.TOPREL.PRED #ppsort,
                                                   CAT.HEAD adp ] ] ].
extracted-comp4-advp-slash-phrase := extracted-comp4-slash-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL [ CONT.HOOK.TOPREL [ARG1 #ind1 ],
			    CAT.VAL.DEP4.LOCAL [ CAT.HEAD adv,
						 CONT.HOOK.TOPREL.ARG1 #ind1 ] ] ].
extracted-comp4-adjp-slash-phrase := extracted-comp4-slash-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL [ CONT.HOOK.TOPREL [ARG1 #ind1 ],
			    CAT.VAL.DEP4.LOCAL [ CAT.HEAD adj,
						 CONT.HOOK.TOPREL.ARG1 #ind1 ] ] ].

;--------------------------------------------------------------------------
;                           FILLER RULES - SLASH
;--------------------------------------------------------------------------
; ERB 2004-08-26 The analysis of relative clauses in the ERG
; requires that the relative clause construction (a kind of
; "head" filler phrase) not actually be a subtype of 
; headed-phrase.  This is because the HEAD.MOD value of
; the mother and the would-be head daughter differ.
; Thus basic-filler-phrase does not inherit form headed-phrase.
; We provide a subtype, basic-head-filler-phrase, below, which does.

; ASF 2011-10-05 changed supertype 'headed-phrase' to more specific 'head-compostional'
; in order to make sure matrix.tdl provides the right semantics.


;LHS & NM: + deleted the requirement of an empty SLASH and REL on the 'head'-dtr because it barred sentences with non-empty QUE and SLASH
;NURIT-REVIVED
basic-slash-filler-phrase := binary-phrase & phrasal & 
  [ SYNSEM [ LOCAL [ CAT [ VAL [ C-FRAME #link,
			  	 DEP1.REAL #link,
			  	 DEP2.REAL #link,
			  	 DEP3.REAL #link,
			  	 DEP4.REAL #link ],
				 POSTHEAD + ] ] ,
			 NON-LOCAL.SLASH 0-dlist ],
    ARGS < phrase & [ SYNSEM [ LOCAL #slash & local &
			[ CTXT.ACTIVATED + ],
			NON-LOCAL.SLASH 0-dlist ] ],
	   [ SYNSEM [ LOCAL.CAT [ VAL [ C-FRAME #link,
			  	 	DEP1.REAL #link,
			  	 	DEP2.REAL #link,
			  	 	DEP3.REAL #link,
			  	 	DEP4.REAL #link ] ],
		      NON-LOCAL [ SLASH 1-dlist & <! #slash !> ] ] ] > ].


basic-head-slash-filler-phrase := basic-slash-filler-phrase & head-compositional.

;NURIT-QUE - this rule cannot be applied to clauses with extracted subject (SF ques)
head-final-slash-filler-phrase := basic-head-slash-filler-phrase & head-final & que-rel-percolate-phrase & no-hcons-ccont-rule &
  [ SYNSEM [ LOCAL.CAT.VAL #val ],
    HEAD-DTR [ SYNSEM [ LOCAL [ CAT [ HEAD v_pron_head,
					VAL #val & [ 	C-FRAME #link,
				  	 		DEP1.REAL #link,
				  	 		DEP2.REAL #link,
				  	 		DEP3.REAL #link,
				  	 		DEP4.REAL #link ] ],
				 CONT.HOOK.INDEX.SF prop ] ] ],
    NON-HEAD-DTR [ SYNSEM phr-synsem & 
			[ NON-LOCAL [ SLASH 0-dlist & [ LIST < > ] ,
				      QUE 0-dlist & [ LIST < > ] ] ] ],
    C-CONT.RELS <! !> ].



;==============
basic-que-filler-phrase := binary-phrase & phrasal & 
  [ SYNSEM [ LOCAL [ CAT [ VAL #val,
				 POSTHEAD + ] ] ,
			 NON-LOCAL.SLASH 0-dlist ],
    ARGS < phrase & [ SYNSEM [ LOCAL #slash & [ CTXT.ACTIVATED + ],
			       NON-LOCAL [ QUE 1-dlist ] ] ],
	   [ SYNSEM [ LOCAL.CAT [ VAL #val ],
		      NON-LOCAL [ SLASH 1-dlist & <! #slash !> ] ] ] > ].

basic-head-que-filler-phrase := basic-que-filler-phrase & head-compositional.

head-final-que-filler-phrase := basic-head-que-filler-phrase & head-final &  no-hcons-ccont-rule &
  [ HEAD-DTR [ SYNSEM [ LOCAL.CAT [ HEAD v_pron_head ] ] ],
    NON-HEAD-DTR [ SYNSEM phr-synsem & 
			[ NON-LOCAL [ SLASH 0-dlist & [ LIST < > ] ,
				      QUE 1-dlist ] ] ],
    C-CONT.RELS <! !> ].






;--------------------------------------------------------------------------
;                           EXTRACTION RULES - QUE
;--------------------------------------------------------------------------


;------------------------------------------
;           COMP
;------------------------------------------

extracted-comp-que-phrase := extracted-comp-phrase & rel-slash-percolate-phrase.

extracted-comp2-que-phrase := extracted-comp-que-phrase & 
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ C-FRAME #frame,
			   DEP1 #dep1,
                           SPR #spr,
			   DEP2 [ REAL #frame & arg2+ ],
			   DEP3 #dep3,
			   DEP4 #dep4 ],
                     	MC #mc ],
	     NON-LOCAL [ QUE 1-dlist & [ LIST < #gap > ] ] ],
    HEAD-DTR [ SYNSEM [ LOCAL.CAT [ VAL [ C-FRAME #frame,
					DEP1 #dep1,
                                        SPR #spr,
					DEP2 [ REAL arg2-,
                                               LOCAL #gap ],
					DEP3 #dep3,
					DEP4 #dep4 ],
                                    MC #mc ] ] ] ].

extracted-comp2-np-que-phrase := extracted-comp2-que-phrase & no-hcons-ccont-rule &
  [ HEAD-DTR [ SYNSEM.LOCAL [ CONT.HOOK.TOPREL.ARG2 #ind2,
                              CAT [ VAL.DEP2.LOCAL [ CAT [ HEAD noun & 
		                                                  [ CASE acc ],
		                                           OBJ-MARK +-or-- ,
                                                       	   VAL.SPR < > ],
                                         	CONT.HOOK.INDEX  ref-ind & #ind2 ] ] ] ] ].

extracted-comp2-vp-que-phrase := extracted-comp2-que-phrase & hcons-ccont-rule &
  [ C-CONT.HCONS <! [ HARG #harg,
		     LARG #larg ] !>,
    HEAD-DTR.SYNSEM [ LOCAL [ 	CONT.HOOK.TOPREL [ ARG2 #harg ],
		      		CAT.VAL.DEP2 [ 	LOCAL [ CAT.HEAD verb,
                                                   	CONT.HOOK [ LTOP  #larg,
                                 	                            INDEX event & [ E.TENSE infinitive ] ] ] ] ] ] ]. 

extracted-comp2-cp-que-phrase := extracted-comp2-que-phrase & hcons-ccont-rule &                                                
  [ C-CONT.HCONS <! [ HARG #harg,
                      LARG #larg ] !> ,
    HEAD-DTR.SYNSEM.LOCAL [ CONT.HOOK.TOPREL [ ARG2 #harg ],
                            CAT [ VAL.DEP2.LOCAL [ CAT.HEAD comp,
                                                 CONT.HOOK [ LTOP  #larg,
                                                             INDEX event & [ E.TENSE finite ] ] ] ] ] ].

extracted-comp3-que-phrase := extracted-comp-que-phrase & no-hcons-ccont-rule &
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ 	C-FRAME #frame,
			       	DEP1 #dep1,
                         	SPR #spr,
                         	DEP3 [ REAL #frame & arg3+ ],
                         	DEP4 #dep4,
                         	DEP2 #dep2 ],
                   	MC #mc ],
	    NON-LOCAL.QUE 1-dlist & [ LIST < #gap > ] ],
    HEAD-DTR [ SYNSEM [	LOCAL [ CAT [ VAL [ C-FRAME #frame,
			       	            DEP1 #dep1,
                               	     	    SPR #spr,
                                            DEP3 [ REAL arg3-,
					           LOCAL #gap ],
                                     	    DEP4 #dep4,
                                     	    DEP2 #dep2 ],
                               	      MC #mc ] ] ] ] ].				                                                 

extracted-comp3-np-que-phrase := extracted-comp3-que-phrase &
  [ HEAD-DTR [ SYNSEM.LOCAL [ CONT.HOOK.TOPREL.ARG3 #ind3,
                              CAT.VAL.DEP3.LOCAL [ CAT [ HEAD noun & 
							            [ CASE acc ],
                                           		 OBJ-MARK +-or-- ,
                                           		 VAL.SPR < > ],
                                                 CONT.HOOK.INDEX  ref-ind & #ind3 ] ] ] ].    
;PPSORT                                                 
extracted-comp3-pp-que-phrase := extracted-comp3-que-phrase & 
  [ SYNSEM.LOCAL.CONT.HOOK.TOPREL.ARG3 #ind3,
    HEAD-DTR [ SYNSEM.LOCAL [ CONT.HOOK.TOPREL.ARG3 #ind3,
                              CAT.VAL.DEP3.LOCAL [ 	CAT.HEAD adp,
                                                 	  CONT.HOOK.TOPREL [ PRED _l_p_rel,
                                                                	     ARG2 ref-ind & #ind3 ] ] ] ] ].   

extracted-comp4-que-phrase := extracted-comp-que-phrase & no-hcons-ccont-rule &
                               head-compositional &
  [ SYNSEM canonical-synsem &
	   [ LOCAL.CAT [ VAL [ 	C-FRAME #frame,
			       	DEP1 #dep1,
                         	SPR #spr,
                         	DEP4 [ REAL #frame & arg4+ ],
                         	DEP3 #dep3,
                         	DEP2 #dep2 ],
                   	MC #mc ],
	    NON-LOCAL.QUE 1-dlist & [ LIST < #gap > ] ],
    HEAD-DTR [ SYNSEM [	LOCAL [ CAT [ VAL [ C-FRAME #frame,
			       	            DEP1 #dep1,
                               	     	    SPR #spr,
                                            DEP4 [ REAL arg4-,
					           LOCAL #gap & [ CONT.HOOK.LTOP handle & #hand4 ] ],
                                     	    DEP3 #dep3,
                                     	    DEP2 #dep2 ],
                               	      MC #mc ],
                          CONT.HOOK.TOPREL [ ARG4 #hand4 ] ] ] ] ].

;PPSORT				                                                 
extracted-comp4-pp-que-phrase := extracted-comp4-que-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL.CAT.VAL [ PPSORT #ppsort,
                            	    DEP4.LOCAL [ CONT.HOOK.TOPREL.PRED #ppsort,
                                                   CAT.HEAD adp ] ] ].

extracted-comp4-advp-que-phrase := extracted-comp4-que-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL [ CONT.HOOK.TOPREL [ARG1 #ind1 ],
			    CAT.VAL.DEP4.LOCAL [ CAT.HEAD adv,
						 CONT.HOOK.TOPREL.ARG1 #ind1 ] ] ].
extracted-comp4-adjp-que-phrase := extracted-comp4-que-phrase & 
  [ HEAD-DTR.SYNSEM.LOCAL [ CONT.HOOK.TOPREL [ARG1 #ind1 ],
			    CAT.VAL.DEP4.LOCAL [ CAT.HEAD adj,
						 CONT.HOOK.TOPREL.ARG1 #ind1 ] ] ].
					  
