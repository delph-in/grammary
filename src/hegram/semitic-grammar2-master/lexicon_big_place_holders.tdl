;==================================================================================
;================================= PREPOSITIONS ===================================
;==================================================================================
;LHS PPSORT:
yl_p := basic-nomod-adposition-lex-np &
  [ STEM < "yl" >,
    SYNSEM.LKEYS.KEYREL.PRED _yl_p_rel ].
l := basic-nomod-adposition-lex-np &
  [ STEM < "l" >,
    SYNSEM.LKEYS.KEYREL.PRED _l_p_rel ].
b := basic-nomod-adposition-lex-np &
  [ STEM < "b" >,
    SYNSEM.LKEYS.KEYREL.PRED _b_p_rel ].
m := basic-nomod-adposition-lex-np &
  [ STEM < "m" >,
    SYNSEM.LKEYS.KEYREL.PRED _m_p_rel ]. 
;LHS 22/12: testing adverbial PPs
m_advp := basic-nomod-adposition-lex-advp &
  [ STEM < "m" >,
    SYNSEM.LKEYS.KEYREL.PRED _m_p_rel ].    
ym_p := basic-nomod-adposition-lex-np &
  [ STEM < "ym" >,
    SYNSEM.LKEYS.KEYREL.PRED _ym_p_rel ].
al_p := basic-nomod-adposition-lex-np &
  [ STEM < "al" >,
    SYNSEM.LKEYS.KEYREL.PRED _al_p_rel ].
;SUBJ-ARG: to enable by phrases, for now, yl idi as one word
yl_idi := basic-nomod-adposition-lex-np &
  [ STEM < "yl", "idi" >,
    SYNSEM.LKEYS.KEYREL.PRED _yl_idi_p_rel ].

;;;;;;;;;;;;;;;;;;;;;;;;;;
;;Idiomatic prepositions;;
;;;;;;;;;;;;;;;;;;;;;;;;;;
;;LHS 11/02/15 MWEs (V+PP)
m_i_from_tree := basic-nomod-adposition-lex-np-i &
  [ STEM < "m" >,
    SYNSEM [ LOCAL.CAT.VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-tree-idea_n_rel,
             LKEYS.KEYREL.PRED _m_from_tree_ip_rel ] ].                            

;POSS Nurit 12/2/15
m_i_from_tools := poss-raise-adposition-lex-np-i &
  [ STEM < "m" >,
    SYNSEM [ LOCAL.CAT.VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-tools-temper_n_rel,
             LKEYS.KEYREL.PRED _m_from_tools_ip_rel ] ].  

;LHS 15/02/15: V+NPpossessive+PP 
b_i_in_sand := basic-nomod-adposition-lex-np-i &
  [ STEM < "b" >,
    SYNSEM [ LOCAL.CAT.VAL.DEP2.DEP.LOCAL.CONT.HOOK.TOPREL.PRED _i-sand-reality_n_rel,
             LKEYS.KEYREL.PRED _b_in_sand_ip_rel ] ].  
                          
;=============================================================================
;================================= FUNCTIONAL ================================
;=============================================================================

at_cm := acc-marking-lex &
  [ STEM < "at" > ].

e := nmc-complementizer-lex-item &
  [ STEM < "e" > ].

mh_c := cp-qpart-lex-item & 
  [ STEM < "mh" >,
   SYNSEM.LKEYS.KEYREL.PRED _mh_c_rel ].

ham_q := qpart-yes-no-lex-item &
  [ STEM < "ham" >,
    SYNSEM.LKEYS.KEYREL.PRED _ham_rel ].

la := neg-adv-lex &
  [ STEM < "la" >,
    SYNSEM.LKEYS.KEYREL.PRED _la_rel ].

w := conj-lex &
  [ STEM < "w" >,
    SYNSEM.LKEYS.KEYREL.PRED _w_rel,
    CFORM "1" ].
