; Marking whether the object marker has applied or not.
; Nurit 9/6 - moved OBJ-MARK from noun to cat in order to be able to refer to it in VALENCE.DEP2 for np-cp-vp
;$OBJ-MARKING$ - flag whether AT was/can be added. Defined for nouns (AT - case marker)
cat :+
  [ OBJ-MARK bool ].

;;; Others

; Nurit 9/6 moved OBJ-MARK from noun to CAT
; definite nouns are defined as OBJ-MARK - 
acc-marking-lex := no-rels-hcons-icons-lex-item &
   [ SYNSEM.LOCAL.CAT [ HEAD det,
			VAL [ R-FRAME no-arg,
			      DEP2.DEP phr-synsem &  [ LOCAL.CAT [  HEAD noun & [  DEF + ],
								OBJ-MARK - ] ] ] ] ].

; TAG 14/1/15: commented out because there is a common case hierarchy in general.tdl								
; TAG 11/01/15: moved Case from general
;;; Case

; case := *top*.
; acc := case.
; non-acc := case.
; nom := non-acc.
; other := non-acc.
