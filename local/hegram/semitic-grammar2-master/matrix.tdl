;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Nurit - 18/6/14 - Information Structure  - not used, moved to save-info-structure-types

;;; lexical marking (a value of cat)
mkg := avm &
  [ FC luk,
	TP luk ].
fc := mkg & [ FC + ].
non-tp := mkg & [ TP - ].
tp := mkg & [ TP + ].
non-fc := mkg & [ FC - ].
fc-only := fc & non-tp.
fc-+-tp := tp & fc.
unmkg := non-tp & non-fc.
tp-only := tp & non-fc.

mkg-tp-lex := lex-item &
  [ SYNSEM.LOCAL.CAT.MKG tp ].
mkg-tp-only-lex := lex-item &
  [ SYNSEM.LOCAL.CAT.MKG tp-only ].
mkg-fc-lex := lex-item &
  [ SYNSEM.LOCAL.CAT.MKG fc ].
mkg-fc-only-lex := lex-item &
  [ SYNSEM.LOCAL.CAT.MKG fc-only ].
mkg-unmkg-lex := lex-item &
  [ SYNSEM.LOCAL.CAT.MKG unmkg ].
 
same-mkg-phrase := headed-phrase &
  [ SYNSEM.LOCAL.CAT.MKG #mkg,
	HEAD-DTR.SYNSEM.LOCAL.CAT.MKG #mkg ].

;;; icons-realted rules
no-icons-ccont-rule := phrase-or-lexrule & word-or-lexrule &
  [ C-CONT.ICONS <! !> ].

;LHS: QEQ returned the original no-ccont-rule and added no-hcons-ccont-rule instead, hcons-ccont-rule, no-rels-ccont:
no-ccont-rule := no-icons-ccont-rule &
  [ C-CONT [ RELS <! !>,
	     HCONS <! !> ] ].
no-hcons-ccont-rule := phrase-or-lexrule & word-or-lexrule &
  [ C-CONT [ HCONS <! !> ] ].
hcons-ccont-rule := phrase-or-lexrule & word-or-lexrule &
  [ C-CONT [ HCONS <! qeq !> ] ].
no-rels-ccont-rule := phrase-or-lexrule & word-or-lexrule &
  [ C-CONT [ RELS <! !> ] ].

scope-arg-rule := phrase-or-lexrule & word-or-lexrule &
  [ SYNSEM.SCOPE-ARG + ].

no-scope-arg-rule := phrase-or-lexrule & word-or-lexrule &
  [ SYNSEM.SCOPE-ARG - ].
