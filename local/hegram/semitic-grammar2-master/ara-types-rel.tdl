;;
;;  Rels hierarchy automatically derived from 
;;  an existing lexicon file (14/11/2016)


;LHS 29/1/15: A (relatively flat) hierarchy of rels to populate LKEYS.KEYREL.PRED.
;Prepositions' rels appear in types-prep-lex, including idiomatic ones.
l-or-i-rel := predsort.
;For idiomatic lexical items
i-rel := l-or-i-rel.
;For literal lexical items (most words)
l-rel := l-or-i-rel.
