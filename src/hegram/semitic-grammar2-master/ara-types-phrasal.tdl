;; ARABIC ;;;

;===============================================
; =============== PHRASAL TYPES=================
;===============================================

;============================================
;THE SUBJECT-HEAD HIERARCHY
;============================================

; TAG 29/1/15: for gender and person agreement in VS
gend-per-agr-phrase := binary-headed-phrase &
[ HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD.CNCRD [ GEND #gend,
                                             PER #per ] ] ],
  NON-HEAD-DTR.SYNSEM.LOCAL [ CAT.HEAD.CNCRD [ GEND #gend,
                                               PER #per ] ] ].


; TAG 11/10/15: To allow OVS order (extraction from VS) the VS rule must be able to operate when the V is object-extracted. 
; Thus, removed the lex-synsem constraint. 
;  TAG 29/1/15: added MC + specification to get V NP structure. 
; TAG 27/1/15: VS order in Arabic forces the verb to be singular
VS-basic-head-subj-phrase :+ gend-per-agr-phrase & [ SYNSEM.LOCAL.CAT [ MC + ],
                                                     HEAD-DTR.SYNSEM.LOCAL.CAT [ HEAD.CNCRD png-s  ] ].	 
                                                         
; TAG 21/10/15: head-comp rules only operate when the subject (arg1+ or arg2+) has been realized.                                                   
basic-head-comp-phrase :+ [ HEAD-DTR.SYNSEM.LOCAL.CAT.VAL.SUBJ-DEP.REAL arg12 ].                                                                                                                                                                                                                                                             							
  
; TAG 28/1/15: commented out, the general rule does not include the OBJ-MARK specification.
;v-head-np-comp4-phrase := head-comp4-phrase &
;  [ HEAD-DTR.SYNSEM.LOCAL.CAT.HEAD v_pron_head,
;    NON-HEAD-DTR.SYNSEM.LOCAL [ CAT [ HEAD noun,
;               			      VAL.R-FRAME no-arg ] ] ].




