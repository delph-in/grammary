;    NONCONJ-DTR.SYNSEM.LOCAL.CAT [ HEAD verb,
;                                   VAL.DEP1 < > ]].
;LHS 08/02/15: REVIVED
s-bottom-coord-phrase := bottom-coord-phrase &
  [ SYNSEM.LOCAL.CAT [ HEAD verb,
                       MC + ],
    NONCONJ-DTR.SYNSEM.LOCAL.CAT [ HEAD verb,
                                   MC + ]].
